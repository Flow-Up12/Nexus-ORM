# Required: Your registry image
DOCKER_IMAGE=ghcr.io/flow-up12/nexus-orm:latest

# Database
POSTGRES_USER=ufo_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ufo_db

# Server
PORT=3001

# Auth (required for production)
JWT_SECRET=your_jwt_secret_change_in_production

# Project DB pool (for creating project databases)
PG_POOL_HOST=postgres
PG_POOL_PORT=5432
PG_POOL_USER=ufo_user
PG_POOL_PASSWORD=your_secure_password
PG_POOL_DEFAULT_DB=postgres
